{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%amount.0", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%amount.0", "bits": 16 },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.1", "guard": null },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.2", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0c", "0x01", "0x20", "%t.1", "%t.2"] },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%t.3", "guard": null },
    { "op": "constrain_bits", "val": "%t.3", "bits": 8 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%t.4", "guard": null },
    { "op": "constrain_bits", "val": "%t.4", "bits": 248 },
    { "op": "persistent_hash", "output": "%bytes.5", "alignment": [{ "tag": "atom", "value": { "length": 32, "tag": "bytes" } }], "inputs": ["%t.3", "%t.4"] },
    { "op": "bytes_into_natives", "outputs": ["%t.6", "%t.7"], "bytes": "%bytes.5" },
    { "op": "test_eq", "output": "%t.8", "a": "%t.1", "b": "%t.7" },
    { "op": "test_eq", "output": "%t.9", "a": "%t.2", "b": "%t.6" },
    { "op": "cond_select", "output": "%t.10", "bit": "%t.8", "a": "%t.9", "b": "0x00" },
    { "op": "assert", "cond": "%t.10" },
    { "op": "impact", "guard": "0x01", "inputs": ["0x70", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0f", "%amount.0"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0xa1"] }
  ]
}
