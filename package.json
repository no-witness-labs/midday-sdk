{
  "name": "@no-witness-labs/midday-sdk",
  "version": "0.7.1",
  "description": "Developer-friendly SDK for building dapps on Midnight Network",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./devnet": {
      "types": "./dist/devnet/index.d.ts",
      "import": "./dist/devnet/index.js"
    }
  },
  "files": [
    "dist",
    "docker",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "prepare": "npm run build",
    "docs:dev": "pnpm --dir website dev",
    "docs:build": "pnpm --dir website build",
    "docs:preview": "pnpm --dir website preview",
    "docs:install": "pnpm --dir website install",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:unit": "vitest run --no-file-parallelism --exclude 'test/*.integration.test.ts' --exclude 'test/e2e/**' test/",
    "test:devnet": "vitest run test/devnet.integration.test.ts",
    "test:e2e": "vitest run --no-file-parallelism test/e2e/",
    "compile:contracts": "COMPACTC_VERSION=0.36.0 run-compactc contracts/counter/simple-counter.compact contracts/counter/ && COMPACTC_VERSION=0.36.0 run-compactc contracts/secret-counter/secret-counter.compact contracts/secret-counter/",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "dependencies": {
    "@effect/platform": "^0.77.0",
    "@effect/schema": "^0.75.0",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnightntwrk/dapp-connector-api": "4.1.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.0.0",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0",
    "@midnightntwrk/wallet-sdk-hd": "4.0.0",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.0",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.0",
    "@midnightntwrk/wallet-sdk-utilities": "1.3.0",
    "@noble/hashes": "2.4.0",
    "dockerode": "^4.0.10",
    "effect": "^3.22.1",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.3",
    "rxjs": "^7.8.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.34.0",
    "@midnight-ntwrk/midnight-js-compact": "5.0.0",
    "@types/dockerode": "^3.3.43",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "eslint": "^9.34.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "midnight",
    "midnight-network",
    "zk-proof",
    "blockchain",
    "privacy",
    "sdk",
    "browser",
    "wallet"
  ],
  "author": "No Witness Labs",
  "license": "MIT",
  "homepage": "https://github.com/no-witness-labs/midday-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no-witness-labs/midday-sdk.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pnpm": {
    "overrides": {
      "@midnightntwrk/ledger-v9": "1.0.0",
      "@midnightntwrk/onchain-runtime-v4": "4.0.0",
      "@midnight-ntwrk/platform-js": "3.0.0",
      "effect": "3.22.1"
    }
  }
}
